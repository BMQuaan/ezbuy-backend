# ==========================================
# EZBuy Backend - Environment Configuration
# ==========================================

# 1. Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ezbuy
DB_USERNAME=root
DB_PASSWORD=your_db_password

# 2. Mail Configuration (Gmail SMTP / App Password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# 3. JWT Security
JWT_SECRET=your_jwt_secret_key_here_at_least_256_bits_long

# 4. Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. VNPay Payment Gateway (Sandbox / Production)
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_CURRENCY=VND

# 6. Service URLs & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8081
